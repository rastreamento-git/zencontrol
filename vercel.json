{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci --include=dev",
  "buildCommand": "npm run build",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": {
      "fix/publica-compras-sga": false,
      "feat/consulta-sga-compras": false,
      "fix/publica-saldo-matriz": false,
      "feat/cobertura-sga": false,
      "fix/atualiza-estoque-demo": false,
      "fix/auditoria-zencontrol": false,
      "feat/ecossistema-homologacao": true,
      "fix/pdf-fechamento-zen": false
    }
  }
}
