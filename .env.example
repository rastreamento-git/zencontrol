# Execute npm run setup para gerar .env com segredos individuais.
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
ZEN_PUBLIC_URL=http://127.0.0.1:3000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Se houver proxy reverso confiável, informe o número de saltos; em acesso direto, deixe vazio.
TRUST_PROXY=

APP_ADMIN_USER=admin
APP_PASSWORD=
SESSION_SECRET=
ZEN_WEBHOOK_SECRET=
ZEN_DATA_DIR=data
# true: fila junto da API, compartilhando o mesmo disco. Não inicie outro worker.
ZEN_RUN_WORKER=false

POSTGRES_PASSWORD=
DATABASE_URL=
# disable: somente conexão local/rede privada. Para banco remoto use verify-full.
DATABASE_SSL=disable
DATABASE_CA=
DATABASE_POOL_MAX=3

# local: disco persistente; supabase: bucket privado para Render Free.
MEDIA_STORAGE=local
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=zencontrol-evidencias

# Habilite somente depois de conferir a migração, os técnicos e os destinos.
INTEGRATIONS_ENABLED=false
AUTO_CLOSE_ENABLED=false
SGA_SYNC_ENABLED=false
SGA_SCHEDULED_CODE=21
SGA_COMPLETED_CODE=1

WPP_API_URL=http://127.0.0.1:21465/api
WPP_SESSION=ZenSeguros
WPP_API_TOKEN=
WPP_SECRET_KEY=

HINOVA_API_URL=https://api.hinova.com.br/api/sga/v2
HINOVA_TOKEN_ASSOC=
HINOVA_USER=
HINOVA_PASS=

# Desenvolvimento: deixe vazio para usar a API em /api pelo mesmo domínio.
VITE_API_URL=
ZEN_API_PROXY=http://127.0.0.1:3000

# Instalação confirmada entre ZenControl e Estoque Pro (servidor a servidor).
STOCK_ENABLED=false
STOCK_API_URL=
STOCK_API_SECRET=
# Identificador permanente desta base. Não altere após a primeira instalação.
STOCK_SOURCE_SYSTEM=zencontrol
